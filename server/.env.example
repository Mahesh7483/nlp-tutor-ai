# ============================================================
# NLP Tutor AI — backend configuration
# Copy this file to `server/.env` and fill in your values.
# Live AI mode requires all three values below; otherwise the
# application starts in clearly-labelled demo mode.
# ============================================================

# Port for the backend server
PORT=8787

# --- Required for live AI responses ---
# OpenAI-compatible chat-completions API configuration.
# AI_BASE_URL should be the root of the OpenAI-compatible API
# (without a trailing slash). Examples:
#   OpenAI:        https://api.openai.com/v1
#   Azure pkt, LM Studio, Ollama (with /v1), OpenRouter, Groq, etc.
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Optional tuning ---
# Max characters allowed per chat message sent from the client
MAX_MESSAGE_CHARS=8000
# Upstream completion request timeout in milliseconds
AI_TIMEOUT_MS=120000
# Max extracted characters retained per uploaded course document
MAX_DOC_CHARS=400000
